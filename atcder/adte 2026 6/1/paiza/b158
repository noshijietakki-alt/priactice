n=int(input())
total=0
g=n//2
for i in range(n):
    s=list(map(int,input().split()))
    if i==0 or i==n-1:
        total+=sum(s)-n
    elif i==g and n>=7:
        total+=sum(s)+(-n*3)+9-((n+1)//2)
    elif i==g and n<7:
        total+=sum(s)+(-n*2)+1
    elif i%2==0 and n>=7:
        total+=sum(s)+(-n*3)+6
    else:
        total+=sum(s)+(-n*2)+2
print(total)
